# =====================================================================
# JESS Salon at Home — environment configuration
# =====================================================================
# Copy this file to `.env.local` for local development, or `.env` for
# production, and fill in the real values.
#
# NEVER commit real secrets. `.env.example` contains placeholders only.
# ---------------------------------------------------------------------

# ---------- App ----------
# Public base URL of the deployed site (no trailing slash).
# Used to build PayRex success/cancel redirect URLs.
# Example: https://jess-salon.example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Supabase (public) ----------
# Project URL, found in Supabase Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co

# Anon (public) key — safe for the browser. Used for admin auth + RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# ---------- Supabase (SECRET — server only) ----------
# Service-role key — FULL access, bypasses RLS. NEVER expose in the browser.
# Found in Supabase Dashboard → Project Settings → API → service_role secret.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# ---------- PayRex (SECRET — server only) ----------
# Secret API key (test or live). Found in the PayRex Dashboard → Developers.
# Test and live share the same API host (https://api.payrexhq.com);
# which key you use determines the mode.
PAYREX_SECRET_API_KEY=sk_test_YOUR_PAYREX_SECRET_KEY

# Webhook signing secret (whsk_...). Found when you register the webhook
# endpoint in PayRex Dashboard → Developers → Webhooks.
PAYREX_WEBHOOK_SECRET_KEY=whsk_YOUR_PAYREX_WEBHOOK_SECRET

# ---------- Slot-lock cleanup (SECRET — server only) ----------
# Shared secret used to protect the cleanup cron endpoint
# (POST /api/bookings/cleanup). Generate a long random string.
# The cron job must send this as: Authorization: Bearer <CLEANUP_API_KEY>
CLEANUP_API_KEY=YOUR_RANDOM_CLEANUP_SECRET
