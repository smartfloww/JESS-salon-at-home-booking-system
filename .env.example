# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Server only. Never use NEXT_PUBLIC_ for this key.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Public website base URL (no trailing slash). Used for PayRex redirect URLs.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ---- PayRex (sandbox) ----
# Leave PAYREX_SECRET_KEY empty to run in MOCK payment mode.
# Get sandbox keys from https://merchants.payrex.com/ (test mode).
PAYREX_SECRET_KEY=
PAYREX_PUBLIC_KEY=
# After registering your webhook in the PayRex dashboard, paste the signing secret here.
PAYREX_WEBHOOK_SECRET=your_webhook_secret_here

# When "true", force mocked checkout even if PayRex keys are configured.
# Set to false and provide PAYREX_SECRET_KEY to use PayRex sandbox checkout.
PAYMENT_MOCK_MODE=true
